generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {\n  ACTIVE\n  INACTIVE\n}
enum OrderStatus {\n  PENDING\n  MEASUREMENT\n  CUTTING\n  STITCHING\n  QUALITY_CHECK\n  READY\n  DELIVERED\n  CANCELLED\n}
enum GarmentType {\n  THOBE\n  SHIRT\n  TROUSER\n  SUIT\n  OTHER\n}
enum PaymentStatus {\n  UNPAID\n  PARTIAL\n  PAID\n}

model Shop {
  id String @id @default(cuid())
  name String
  area String
  phone String?
  active Boolean @default(true)
  customers Customer[]
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}

model Customer {
  id String @id @default(cuid())
  customerNo String @unique
  name String
  phone String
  email String?
  address String?
  notes String?
  status CustomerStatus @default(ACTIVE)
  shopId String?
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  measurements Measurement[]
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([phone])
  @@index([shopId])
}

model Measurement {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  garment GarmentType
  profileName String @default("Standard")
  values Json
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([customerId, garment, profileName])
  @@index([customerId])
}

model Order {
  id String @id @default(cuid())
  orderNo String @unique
  customerId String
  shopId String?
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  status OrderStatus @default(PENDING)
  garment GarmentType
  description String
  quantity Int @default(1)
  totalAmountFils Int
  paidAmountFils Int @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  orderDate DateTime @default(now())
  deliveryDate DateTime?
  notes String?
  sizeBreakdowns OrderSizeBreakdown[]
  referenceImages OrderReferenceImage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId])
  @@index([shopId])
  @@index([status])
  @@index([orderDate])
  @@index([deliveryDate])
}

model OrderSizeBreakdown {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  size String
  quantity Int
  @@unique([orderId, size])
  @@index([orderId])
}

model OrderReferenceImage {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileName String
  storagePath String
  mimeType String
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  @@index([orderId])
}