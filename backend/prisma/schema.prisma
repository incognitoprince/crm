generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}
enum OrderStatus {
  PENDING
  MEASUREMENT
  CUTTING
  STITCHING
  QUALITY_CHECK
  READY
  DELIVERED
  CANCELLED
}
enum GarmentType {
  THOBE
  SHIRT
  TROUSER
  SUIT
  OTHER
}
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Shop {
  id String @id @default(cuid())
  name String
  area String
  phone String?
  whatsapp String?
  email String?
  arabicName String?
  englishName String?
  logoPath String?
  logoUrl String?
  address String?
  active Boolean @default(true)
  customers Customer[]
  orders Order[]
  masters Master[]
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}

model Garment {
  id String @id @default(cuid())
  name String @unique
  active Boolean @default(true)
  sortOrder Int @default(0)
  orders Order[] @relation("OrderGarment")
  designs Design[] @relation("DesignGarment")
  measurements Measurement[] @relation("MeasurementGarment")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, sortOrder])
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role UserRole @default(STAFF)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
}

enum UserRole {
  OWNER
  STAFF
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id String @id @default(cuid())
  customerNo String @unique
  name String
  phone String
  email String?
  address String?
  notes String?
  status CustomerStatus @default(ACTIVE)
  shopId String?
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  measurements Measurement[]
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([phone])
  @@index([shopId])
}

model Measurement {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  garment GarmentType
  garmentId String?
  garmentMaster Garment? @relation("MeasurementGarment", fields: [garmentId], references: [id], onDelete: SetNull)
  profileName String @default("Standard")
  values Json
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([customerId, garment, profileName])
  @@index([customerId])
  @@index([garmentId])
}

model Order {
  id String @id @default(cuid())
  orderNo String @unique
  customerId String
  shopId String?
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  status OrderStatus @default(PENDING)
  garment GarmentType
  garmentId String?
  garmentMaster Garment? @relation("OrderGarment", fields: [garmentId], references: [id], onDelete: SetNull)
  description String
  quantity Int @default(1)
  totalAmountFils Int
  paidAmountFils Int @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  orderDate DateTime @default(now())
  deliveryDate DateTime?
  notes String?
  sizeBreakdowns OrderSizeBreakdown[]
  referenceImages OrderReferenceImage[]
  designs OrderDesign[]
  masterAssignments MasterAssignment[]
  payments Payment[]
  invoices Invoice[]
  invoiceLines InvoiceLine[]
  sizePrices Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId])
  @@index([shopId])
  @@index([status])
  @@index([garmentId])
  @@index([orderDate])
  @@index([deliveryDate])
}

model OrderSizeBreakdown {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  size String
  quantity Int
  @@unique([orderId, size])
  @@index([orderId])
}

model Master {
  id String @id @default(cuid())
  name String
  phone String?
  shopId String
  active Boolean @default(true)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  assignments MasterAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shopId, active])
  @@index([name])
}

model Design {
  id String @id @default(cuid())
  designNo String @unique
  name String
  garment GarmentType
  garmentId String?
  garmentMaster Garment? @relation("DesignGarment", fields: [garmentId], references: [id], onDelete: SetNull)
  description String?
  imagePath String?
  active Boolean @default(true)
  orderDesigns OrderDesign[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([garment, active])
  @@index([garmentId])
  @@index([name])
}

model OrderDesign {
  id String @id @default(cuid())
  orderId String
  designId String?
  designName String?
  imagePath String?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  design Design? @relation(fields: [designId], references: [id], onDelete: Restrict)
  notes String?
  assignments MasterAssignment[]
  createdAt DateTime @default(now())
  @@unique([orderId, designId])
  @@index([orderId])
  @@index([designId])
}

model MasterAssignment {
  id String @id @default(cuid())
  orderId String?
  orderDesignId String?
  masterId String
  size String
  quantity Int
  notes String?
  startedAt DateTime?
  completedAt DateTime?
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderDesign OrderDesign? @relation(fields: [orderDesignId], references: [id], onDelete: Cascade)
  master Master @relation(fields: [masterId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId, size])
  @@index([orderDesignId, size])
  @@index([masterId])
}

model OrderReferenceImage {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileName String
  storagePath String
  mimeType String
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  @@index([orderId])
}


enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountFils Int
  method PaymentMethod
  reference String?
  notes String?
  receivedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId])
  @@index([receivedAt])
}


model Invoice {
  id String @id @default(cuid())
  invoiceNo String @unique
  shopId String?
  customerId String?
  orderId String?
  subject String?
  modelNo String?
  modelImagePath String?
  totalFils Int @default(0)
  notes String?
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines InvoiceLine[]
  issuedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shopId])
  @@index([customerId])
  @@index([orderId])
  @@index([issuedAt])
}

model InvoiceLine {
  id String @id @default(cuid())
  invoiceId String
  orderId String?
  orderDate DateTime?
  description String
  quantity Int
  unitPriceFils Int
  totalFils Int
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([invoiceId])
  @@index([orderId])
}
